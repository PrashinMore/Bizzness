# -----------------------------------------------------------------------------
# EZCommerse / Bizzness API — environment variables
# Copy to `.env` and adjust. Never commit real secrets.
# -----------------------------------------------------------------------------

# Local development (matches be/compose.yaml defaults when using Docker DB)
DB_HOST=localhost
# Host port is 5433 when using `docker compose` in this folder; use 5432 for a
# native local Postgres install.
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Production / hosted Postgres — set ONE of the following on your host:

# Recommended: full connection URL (session / direct mode, typically port 5432)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Or individual variables (do NOT use postgres.<project-ref> as DB_HOST)
# DB_HOST=aws-1-us-east-1.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<your-db-password>
# DB_NAME=postgres
# POSTGRES_HOST=aws-1-us-east-1.pooler.supabase.com

# Optional aliases some hosts inject (used by database.config.ts fallbacks)
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_PRISMA_URL=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# Optional: used only to recover a project ref if DB_HOST was mis-set
# SUPABASE_URL=https://<project-ref>.supabase.co

# Required in production — use a long random string
JWT_SECRET=change-me

# HTTP
PORT=4000
# Public origin of this API (used for absolute links, e.g. invoice PDFs / uploads)
BASE_URL=http://localhost:4000
# Web app origin (informational; CORS currently allows all origins)
FRONTEND_ORIGIN=http://localhost:3000

# Serverless / special hosts (usually leave unset locally)
# VERCEL=
# AWS_LAMBDA_FUNCTION_NAME=
# IS_SERVERLESS=
