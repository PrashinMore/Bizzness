# Local development (Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Production (Supabase) — set ONE of the following on your hosting platform:

# Recommended: full connection URL (session mode, port 5432)
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Or individual variables (do NOT use postgres.<project-ref> as DB_HOST)
# DB_HOST=aws-1-us-east-1.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<your-db-password>
# DB_NAME=postgres
# POSTGRES_HOST=aws-1-us-east-1.pooler.supabase.com

JWT_SECRET=change-me
PORT=4000
